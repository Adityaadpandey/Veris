[Unit]
Description=Veris Headless Camera (Bluetooth shutter trigger)
After=network.target bluetooth.target
Requires=bluetooth.target

[Service]
Type=simple
User=%i
Environment=PYTHONUNBUFFERED=1
WorkingDirectory=/home/%i/Veris/hardware-camera-app
EnvironmentFile=-/home/%i/Veris/hardware-camera-app/.env
ExecStart=/home/%i/camera-env/bin/python3 /home/%i/Veris/hardware-camera-app/headless_camera_app.py
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
