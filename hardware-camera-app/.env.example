# ── Veris Camera App ────────────────────────────────────────────────────
# Copy this file to .env and fill in the values for this specific Pi.
# Loaded automatically by headless-camera.service (EnvironmentFile=); for
# the Kivy app / manual runs, `source .env` before launching, or export
# these in your shell profile.

# Backend that receives uploads and creates claims (hardware-web3-service)
BACKEND_URL=http://localhost:5000

# Where captured photos/videos are written on this Pi
CAPTURE_DIR=/home/pi/captures

# ── Headless Bluetooth trigger mode ─────────────────────────────────────
# A short, unique id for this physical unit. Used to build the advertised
# Bluetooth name: Veris-Cam-<DEVICE_ID>. Pick anything stable (e.g. pi01) -
# it does not need to match the camera's derived hardware camera_id.
DEVICE_ID=pi01

# Override the advertised Bluetooth name outright instead of deriving it
# from DEVICE_ID (optional - defaults to Veris-Cam-<DEVICE_ID>).
# BT_DEVICE_NAME=Veris-Cam-pi01

# Paired phone's Bluetooth MAC address (bluetoothctl devices, after
# pairing). Required for Bluetooth PAN tethering; if unset, tethering is
# skipped and uploads rely on whatever network the Pi already has.
PHONE_MAC=

# Seconds to wait for a Bluetooth PAN DHCP lease before giving up and
# falling back to the offline retry queue.
TETHER_TIMEOUT=10

# Seconds between background retries of queued (offline) uploads.
RETRY_INTERVAL=300

# ── Camera hardware ──────────────────────────────────────────────────────
# Degrees to rotate captured/preview frames: 0, 90, 180, 270, or -90.
CAMERA_ROTATION=-90

PREVIEW_SIZE=1920,1080
PREVIEW_FRAMERATE=30
PHOTO_SIZE=1920,1080
VIDEO_SIZE=1280,720
VIDEO_BITRATE=10000000

MIN_ZOOM=1.0
MAX_ZOOM=4.0
ZOOM_STEP=0.5

# ── Kivy touchscreen app only (raspberry_pi_camera_app.py) ──────────────
SHOW_CURSOR=true
KIVY_FULLSCREEN=auto
KIVY_LOG_LEVEL=info
CLAIM_POLL_INTERVAL=5

# ── Hardware identity (device signing key) ───────────────────────────────
# Where the device's salt is stored (used to derive its signing key).
# Defaults assume /boot is writable on a Pi; override if not.
# SALT_PATH=/boot/.device_salt
# SALT_BACKUP_PATH=/home/pi/.lensmint/.device_salt_backup

# Where the exported public device key is written for the backend to read.
# DEVICE_KEY_EXPORT_PATH=/home/pi/Veris/hardware-camera-app/.device_key_export
