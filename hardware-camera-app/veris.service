[Unit]
Description=Veris Web3 Camera System
After=network.target

[Service]
Type=forking
User=%i
WorkingDirectory=%h/veris
ExecStart=/usr/bin/pm2 start %h/veris/ecosystem.config.js
ExecReload=/usr/bin/pm2 reload %h/veris/ecosystem.config.js
ExecStop=/usr/bin/pm2 stop %h/veris/ecosystem.config.js
PIDFile=%h/.pm2/pm2.pid
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
