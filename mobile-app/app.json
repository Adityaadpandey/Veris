{
  "expo": {
    "name": "veris-hotshoe-app",
    "slug": "veris-hotshoe-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "verishotshoeapp",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "com.tunyt.veris-hotshoe-app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.tunyt.verishotshoeapp"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-secure-store",
      "./plugins/withHotshoeBluetooth.js",
      "expo-sharing",
      "expo-asset",
      [
        "expo-media-library",
        {
          "photosPermission": "Veris Hotshoe needs access to your photos to save sealed frames.",
          "savePhotosPermission": "Veris Hotshoe needs permission to save sealed frames to your photos."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Veris Hotshoe needs camera access so Click Photo can capture a frame to seal."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Veris Hotshoe needs access to your photos so you can pick a frame to seal."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
