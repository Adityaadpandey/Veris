# Copy to .env and fill in. Never commit the real .env.
PORT=8787

# --- Setu DigiLocker-as-a-service (https://bridge.setu.co) ---
# Get these from the Setu dashboard after creating a "DigiLocker" product.
SETU_CLIENT_ID=
SETU_CLIENT_SECRET=
SETU_PRODUCT_INSTANCE_ID=
# https://dg-sandbox.setu.co while testing, https://dg.setu.co in production.
SETU_BASE_URL=https://dg-sandbox.setu.co

# Public base URL of THIS server (used to build the intermediate HTTPS
# redirect Setu/DigiLocker sends the user's browser back to before we
# bounce them into the app via its custom URL scheme). Must be a real
# HTTPS URL Setu/DigiLocker can reach — a custom scheme is not accepted
# as their own redirect target.
PUBLIC_SERVER_URL=http://localhost:8787

# The Expo app's deep link the browser is bounced to after that. In dev
# this is printed by `npx uri-scheme list` / matches app.json's "scheme".
APP_DEEP_LINK_SCHEME=verishotshoeapp
