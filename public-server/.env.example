# ── LensMint Claim Server ─────────────────────────────────────────────────
PORT=5001

# Public URLs (must NOT be localhost — used to build claim links)
CLAIM_SERVER_URL=https://lensmint.onrender.com
FRONTEND_URL=https://lensmint.onrender.com

# CORS
CORS_ORIGIN=*

# Database (Postgres — e.g. Neon connection string, must include sslmode=require)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# IPFS gateway used to fetch/serve images
LIGHTHOUSE_GATEWAY=https://unemployed-tyrannosaurus-wprec.lighthouseweb3.xyz/ipfs

# ── OpenAI (descriptions + semantic search embeddings) ─────────────────────
# Get a key at https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_VISION_MODEL=gpt-4.1-mini
OPENAI_EMBED_MODEL=text-embedding-3-small
OPENAI_EMBED_DIM=1536
OPENAI_TIMEOUT=30000

# Minimum blended score (0-1) for a photo to appear in the "similar" list.
SEARCH_MIN_SCORE=0.7

# How much the "similar" ranking weights VISUAL look (perceptual hash) vs
# CONTENT/subject (OpenAI embedding). 0.7 = 70% visual, 30% content. Higher =
# stricter about actual visual likeness, so "same scene, different angle" drops
# out instead of scoring high on shared subject matter. Range 0-1.
SEARCH_VISUAL_WEIGHT=0.7

# Max perceptual-hash Hamming distance (0-64) for an upload to count as the
# SAME source image (an "altered copy"). Lower = stricter. 10 is a good default.
# Used as the default for TAMPER_STRUCTURAL_MAX below if that's unset.
PHASH_MAX_DISTANCE=10

# ── Tamper verdict tiers (Verify & Search) ──────────────────────────────────
# Weighted, normalized (0-1) distance across dHash + pHash-DCT + aHash (see
# imageHash.combinedHashDistance). Below RECOMPRESSED_MAX = just re-saved/
# re-encoded; below STRUCTURAL_MAX = visibly edited but same source; below
# POSSIBLE_MAX = probably the same source, low confidence; above POSSIBLE_MAX
# = not treated as a hash match at all.
TAMPER_RECOMPRESSED_MAX=0.05
TAMPER_STRUCTURAL_MAX=0.15625
TAMPER_POSSIBLE_MAX=0.24

# Delay between images during backfill (ms) to respect OpenAI rate limits
BACKFILL_DELAY_MS=1500

# Shared secret required to call POST/GET /api/enrich/backfill (send as the
# X-Admin-Token header). Leave unset to keep that route disabled.
ADMIN_TOKEN=

# ── Cloudinary (Companion Capture: mobile photo storage) ───────────────────
# The mobile app's own photo alongside the real device capture — demo-quality,
# stored via Cloudinary rather than Filecoin since it isn't the source of truth.
# Get credentials from your Cloudinary dashboard (cloudinary.com/console).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── CLIP semantic-visual recovery (clipService.js) ──────────────────────────
# Runs IN-PROCESS via @xenova/transformers — no separate service to deploy.
# Recovers matches for edits heavy enough (strong filters, noise) to push
# every hash tier above past TAMPER_POSSIBLE_MAX, since CLIP compares semantic
# content rather than pixel statistics.
#
# OFF BY DEFAULT — OPT IN ONLY. This adds ~150-250MB resident memory once the
# model loads, which is most of the budget on a small (e.g. 512MB) Render
# instance on top of everything else the process already holds. Only set
# ENABLE_CLIP=1 if the instance size has real headroom for that; otherwise
# leave it unset — every caller already checks availability first, so the
# rest of Verify & Search works completely normally without it.
ENABLE_CLIP=
CLIP_MODEL_ID=Xenova/clip-vit-base-patch32
# Minimum cosine similarity (0-1) for the CLIP fallback to report a match.
# Kept high by default — CLIP is a softer signal than the deterministic hash
# tiers above it, so this only fires when hashing found nothing at all.
CLIP_MATCH_MIN_SCORE=0.9
