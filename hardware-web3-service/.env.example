PORT=5000
CAPTURES_PATH=/home/pi/veris/captures
NODE_ENV=production

# Future Web3 Integration
# WALLET_PRIVATE_KEY=your_wallet_private_key_here
# IPFS_API_URL=https://ipfs.infura.io:5001
# NFT_CONTRACT_ADDRESS=0x...
# BLOCKCHAIN_RPC_URL=https://mainnet.infura.io/v3/YOUR_KEY

VERIFIER_CONTRACT_ADDRESS=0x0b693F079939c6C6A08AAd4cEAfbcd2cF2FdcCAc

# Public URL of this hardware-web3-service (used for device verification callbacks)
# e.g. your ngrok URL or a public IP
DEVICE_API_URL=https://your-ngrok-url.ngrok-free.app

# How often (ms) to automatically sweep for images stuck short of 'minted' — e.g. claim creation
# failed because the Pi's Bluetooth PAN tethering hadn't finished coming up yet. Independent of
# claimClient's own fast in-request retries; this is the safety net for outages longer than those.
AUTO_RETRY_INTERVAL_MS=60000

# --- Capture packet checks (upload route) ---
# Set to false only to accept old cameras that don't sign a packet yet
# ENFORCE_PACKET=true
# How old a signed packet may be when it arrives (captures made offline upload later)
# PACKET_MAX_AGE_HOURS=24
# Browser origins allowed to call this service (comma list). Pi apps send no Origin and are unaffected.
# CORS_ORIGINS=https://veris.live,http://localhost:3000
# Shared with public-server; sent as x-device-secret on claim writes
# DEVICE_API_SECRET=

# --- Storage: Lighthouse is the default, 0G is optional ---
# STORAGE_PROVIDER=lighthouse        # '0g' makes 0G first, Lighthouse the fallback
# ZEROG_PRIVATE_KEY=                 # low-credit key, rotate after the event
# ZEROG_EVM_RPC=https://evmrpc-testnet.0g.ai
# ZEROG_INDEXER_RPC=https://indexer-storage-testnet-turbo.0g.ai
# ZEROG_STORAGESCAN_URL=             # StorageScan link with {root} where the root hash goes

# --- Chains: sepolia is the default, add arc to mint on both ---
# CHAINS=arc            (default: mint on the primary chain only; "arc,sepolia" mints on both)
# ARC_RPC_URL=https://rpc.testnet.arc.network
# The registry owner's key. DeviceRegistry.registerDevice is owner-only on new deployments.
# REGISTRAR_PRIVATE_KEY=
